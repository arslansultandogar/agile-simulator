classDiagram
    class SimulationConfig {
        +team_size
        +number_of_sprints
        +number_of_tasks
        +task_type
        +task_mix
        +ai_support_level
        +trust_in_ai
        +ai_reliability
        +effort_management
        +skills_knowledge_coordination
        +task_strategy
        +female_proportion
        +team_engagement_baseline
        +consequentiality
        +task_complexity
        +dashboard_quality
        +collective_memory
        +collective_attention
        +collective_reasoning
        +dependency_density
        +enable_rework
        +enable_sprint_phases
        +random_seed
    }

    class WeightsConfig {
        <<config/weights.yaml>>
        +model_version
        +ci_component_weights
        +age_diversity_penalty_weight
        +team_effectiveness_weights
    }

    class TeamMember {
        +member_id
        +name
        +gender
        +age
        +role
        +skill_level
        +availability
        +communication_level
        +social_sensitivity
        +trust_in_ai
        +perceived_ai_reliability
        +work_speed
        +error_tendency
    }

    class RoleModifiers {
        <<team.py>>
        +strategy
        +consequentiality
        +participation
        +coordination
        +blocker_relief
        +delivery
        +defect_detection
    }

    class Task {
        +task_id
        +task_type
        +difficulty
        +effort_points
        +priority
        +uncertainty
        +required_skill_level
        +depends_on
        +is_rework
        +origin_task_id
        +available_from_sprint
    }

    class TaskTypeProfile {
        +coordination_need
        +defect_risk
        +uncertainty_modifier
        +skill_demand
        +completion_bonus
    }

    class SprintPhases {
        <<simulation.py>>
        +planning_quality
        +review_quality
        +retro_quality
    }

    class CollectiveIntelligenceComponents {
        +transactive_memory
        +shared_attention
        +shared_reasoning
        +social_sensitivity
        +participation_balance
        +transactive_coordination
        +team_engagement
        +skill_diversity
        +age_diversity
    }

    class SprintResult {
        +planned_points
        +completed_points
        +carry_over_points
        +carry_over_tasks
        +blocked_tasks
        +rework_created
        +rework_completed
        +defects_caught_in_review
        +velocity
        +completion_rate
        +defect_rate
        +decision_quality
        +collective_intelligence
        +team_effectiveness
        +ai_benefit
        +trust_calibration
        +team_viability
        +member_sustainability
        +overload_pressure
        +planning_quality
        +review_quality
    }

    class AISupport {
        <<module>>
        allocate_tasks_with_ai()
        shared_cognition_assistant()
        update_team_trust_after_sprint()
    }

    class MetricsEngine {
        <<module>>
        compute_collective_intelligence_components()
        decision_quality_score()
        team_effectiveness_score()
        trust_calibration_score()
    }

    WeightsConfig ..> MetricsEngine : configures weights
    SimulationConfig "1" --> "1..*" TeamMember : generates
    SimulationConfig "1" --> "1..*" Task : generates mixed backlog
    TeamMember "1..*" --> "1" RoleModifiers : aggregates to
    Task "n" --> "1" TaskTypeProfile : uses
    Task "0..*" --> "0..*" Task : depends_on
    Task "1" ..> "0..1" Task : creates rework
    TeamMember "1..*" --> "0..*" Task : assigned_to
    TeamMember "1..*" --> "1" CollectiveIntelligenceComponents : contributes_to
    SprintPhases ..> SprintResult : modifies
    RoleModifiers ..> SprintResult : modifies
    CollectiveIntelligenceComponents "1" --> "1" SprintResult : influences
    AISupport ..> TeamMember : updates trust
    AISupport ..> Task : allocates
    MetricsEngine ..> CollectiveIntelligenceComponents : computes
    MetricsEngine ..> SprintResult : computes
