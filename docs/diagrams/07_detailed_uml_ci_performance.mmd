        CM2["↑ collective_memory"]
        CA2["↑ collective_attention"]
        CR2["↑ collective_reasoning"]
        TE2["↑ team_engagement"]
    end

    CI -->|"direct +10%"| COMP
    DQ -->|"direct +8%"| COMP
    TE -->|"direct +5%"| COMP

    DQ -->|"direct −10%"| DEF

    COMP --> VEL
    COMP --> CRATE
    DEF --> DRATE

    CI -->|"direct +15%"| EFF
    DQ -->|"direct +15%"| EFF
    VEL -->|"via velocity_ratio +30%"| EFF
    CRATE -->|"via completion_rate +25%"| EFF
    DRATE -->|"via 1−defect_rate +15%"| EFF

    VEL --> OS
    CRATE --> OS
    DRATE --> OS
    OS --> CM2
    OS --> CA2
    OS --> CR2
    OS --> TE2
    CM2 -.-> CM
    CA2 -.-> CA
    CR2 -.-> CR
    TE2 -.-> TEB

